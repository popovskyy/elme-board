# Machine token for the runner and the CLI (long random string). Same value in Vercel env and on the PC.
BOARD_TOKEN=
# Board URL the runner and CLI call (local dev: http://127.0.0.1:4400).
BOARD_URL=http://127.0.0.1:4400
# Postgres (Neon via Vercel Marketplace). Empty = local JSON file store (BOARD_FILE).
DATABASE_URL=
# Local file store, used when DATABASE_URL is empty.
BOARD_FILE=./data/board.json
# Vercel Deployment Protection bypass for automation (runner/CLI), if protection is on.
VERCEL_PROTECTION_BYPASS=
# Runner: path to the elme-hyva repo on the PC.
REPO_DIR=/home/romanod/Documents/BartGroup/elme-hyva
